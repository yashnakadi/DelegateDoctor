# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/

# Secrets. DelegateDoctor uses no API key, account or remote service of any
# kind, but a developer's machine still has secrets on it, and these must never
# be committed.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
.netrc

# Editors / OS
.idea/
.vscode/
.DS_Store

# ExecuTorch source checkout and native build trees.
# `delegate-doctor setup-android` recreates these from a pinned commit.
.build/

# Cross-compiled Arm64 runner binaries.
# `delegate-doctor setup-android` builds these; they are too large to commit.
runners/*
!runners/.gitkeep

# The user's own model workspace. Their model source, weights and exported
# programs are private and must never be committed.
models/*
!models/README.md

# Per-run output: .pte files, ETDump traces, profiles, reports.
artifacts/*
!artifacts/.gitkeep

# Machine-generated run results are ignored; the written-up validation records
# are not. They are the evidence the README cites, so a clone that did not
# contain them would have a README full of broken links and unsupported numbers.
results/*
!results/.gitkeep
# !results/dd001_segmentation_generalization.md
# !results/dd002_research.md
# !results/dd002_research_v2.md
# !results/dd002_emulator_validation.md
# !results/dd003_avgpool_validation.md

# Research of potential fallbacks
research/*

# Local DelegateDoctor configuration
.delegate-doctor/
